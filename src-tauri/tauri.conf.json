{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fernwerk",
  "version": "0.3.0",
  "identifier": "de.jadenk.fernwerk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fernwerk",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "SSH, SFTP, Monitoring und Server-Verwaltung",
    "longDescription": "Fernwerk vereint SSH-Terminal, SFTP-Dateibrowser, Server-Monitoring, Tunnel, Dienst- und Benutzerverwaltung in einer Desktop-App.",
    "copyright": "© 2026 JadnK",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "section": "net" }
    }
  }
}
